		<widget source="session.Event_Now" render="Label" position="580,414" size="200,58" font="NGLcd;40" foregroundColor="#9aa3ae" halign="right" valign="center" noWrap="1">
			<convert type="EventTime">EndTime</convert><convert type="ClockToText">Format:%H:%M</convert>
		</widget>
	</screen>

