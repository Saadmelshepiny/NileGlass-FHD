<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- NileGlass FHD - front display (800x480). Every screen not defined here comes from the image's default display skin. -->
<skin>
	<include filename="/usr/share/enigma2/display/skin_default/skin_display_templates.xml"/>
	<fonts>
		<font filename="NileGlass-Medium.ttf" name="NGLcd" scale="100"/>
		<font filename="NileGlass-Regular.ttf" name="NGLcdLight" scale="100"/>
	</fonts>

	<screen name="InfoBarSummary" position="fill" resolution="800,480" backgroundColor="#000000">
		<eLabel position="0,0" size="800,6" backgroundColor="#2f9cff" zPosition="1"/>
		<widget source="session.CurrentService" render="LcdPicon" position="20,24" size="300,180" alphatest="blend" zPosition="2">
			<convert type="ServiceName">Reference</convert>
		</widget>
		<widget source="global.CurrentTime" render="Label" position="340,16" size="440,100" font="NGLcd;96" foregroundColor="#ffffff" halign="right" valign="center" noWrap="1">
			<convert type="ClockToText">Format:%H:%M</convert>
		</widget>
		<widget source="global.CurrentTime" render="Label" position="460,120" size="320,40" font="NGLcdLight;32" foregroundColor="#f2c94c" halign="right" valign="center" noWrap="1">
			<convert type="ClockToText">Format:%a %d %b</convert>
		</widget>
		<widget source="global.CurrentTime" render="Label" position="340,162" size="440,36" font="NGLcdLight;27" foregroundColor="#9aa3ae" halign="right" valign="center" noWrap="1">
			<convert type="NGHijri"/>
		</widget>
		<widget source="session.RecordState" render="FixedLabel" text="REC" position="340,122" size="110,38" font="NGLcd;32" foregroundColor="#ff4040" halign="left" valign="center" zPosition="3">
			<convert type="ConditionalShowHide"/>
		</widget>
		<widget source="session.CurrentService" render="Label" position="20,212" size="760,66" font="NGLcd;54" foregroundColor="#ffffff" halign="center" valign="center" noWrap="1">
			<convert type="ServiceName">Name</convert>
		</widget>
		<widget source="session.Event_Now" render="Label" position="20,282" size="760,100" font="NGLcdLight;42" foregroundColor="#2f9cff" halign="center" valign="center">
			<convert type="EventName">Name</convert>
		</widget>
		<eLabel position="20,394" size="760,12" backgroundColor="#1d2633" zPosition="1"/>
		<widget source="session.Event_Now" render="Progress" position="20,394" size="760,12" foregroundColor="#2f9cff" backgroundColor="#1d2633" zPosition="2">
			<convert type="EventTime">Progress</convert>
		</widget>
		<widget source="session.Event_Now" render="Label" position="20,414" size="200,58" font="NGLcd;40" foregroundColor="#9aa3ae" halign="left" valign="center" noWrap="1">
			<convert type="EventTime">StartTime</convert><convert type="ClockToText">Format:%H:%M</convert>
		</widget>
		<widget source="session.Event_Now" render="Label" position="230,414" size="340,58" font="NGLcd;40" foregroundColor="#ffffff" halign="center" valign="center" noWrap="1">
			<convert type="EventTime">VFDRemaining</convert><convert type="RemainingToText">VFD</convert>
